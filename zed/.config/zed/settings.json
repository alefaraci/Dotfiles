// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
//
{
  // Privacy
  "icon_theme": "Catppuccin Macchiato",
  "ssh_connections": [
    {
      "host": "alenia-server",
      "args": [],
      "projects": [
        {
          "paths": ["/./"],
        },
        {
          "paths": ["/rpool/data/subvol-114-disk-0/./"],
        },
      ],
    },
  ],
  "theme": {
    "mode": "dark",
    "dark": "One Dark",
    "light": "One Light",
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },

  // Vim Mode
  "vim_mode": true,
  "vim": {
    "cursor_shape": {
      "normal": "block",
      "insert": "bar",
      "replace": "hollow",
      "visual": "underline",
    },
    "use_system_clipboard": "always",
  },

  // Editor Appearance
  "ui_font_family": "SF Pro",
  "ui_font_size": 13,
  "buffer_font_size": 13,
  "buffer_line_height": { "custom": 1.3 },
  "cursor_shape": "bar",
  "indent_guides": { "enabled": true, "coloring": "indent_aware" },
  "scrollbar": {
    "show": "auto",
    "cursors": true,
    "git_diff": true,
    "search_results": true,
    "selected_text": true,
    "selected_symbol": true,
    "diagnostics": "all",
    "axes": {
      "horizontal": false,
      "vertical": false,
    },
  },
  "minimap": {
    "max_width_columns": 90,
    "current_line_highlight": "line",
    "thumb": "always",
    "show": "always",
  },
  "experimental.theme_overrides": {
    "scrollbar.thumb.background": "#9ca6b512",
    "scrollbar.track.background": "#232427",
  },

  // Edit Predictions (AI Completions)
  "show_edit_predictions": false,
  "edit_predictions": { "mode": "subtle" },

  // Project Panel & Tabs
  "project_panel": {
    "folder_icons": true,
    "entry_spacing": "standard",
  },
  "tabs": {
    "git_status": true,
    "close_position": "left",
  },
  "file_scan_exclusions": [
    "**/.git",
    "**/.DS_Store",
    "**/.gitattributes",
    "**/.python-version",
    "**/.venv",
    "**/__pycache__",
    "**/.ruff_cache",
    "**/.ropeproject",
    "**/.pytest_cache",
    "**/.hypothesis",
    "**/*.lock",
    // LaTeX files
    "**/*.toc",
    "**/*.gz",
    "**/*.out",
    "**/*.lot",
    "**/*.lof",
    "**/*.glo",
    "**/*.fls",
    "**/*.acn",
    "**/*.aux",
    "**/*.bbl",
    "**/*.blg",
    "**/*.fdb_latexmk",
    "**/*.ist",
    "**/*.nlo",
    "**/*.glsdefs",
    "**/*.nls",
    "**/*.synctex.gz",
    "**/*.ilg",
    "**/*.nav",
    "**/*.acr",
    "**/*.alg",
    "**/._*",
    "**/*.gls",
    "**/*.glg",
  ],

  // Git
  "git": {
    "inline_blame": {
      "enabled": false,
      "delay_ms": 5000,
    },
  },

  // Terminal
  "terminal": {
    "font_family": "JetBrainsMono Nerd Font",
    "font_weight": 300,
    "font_size": 13,
    "line_height": "standard",
    "blinking": "on",
    "dock": "bottom",
    "toolbar": { "breadcrumbs": false },
  },

  // LSP & Language Settings
  "lsp_document_colors": "background",
  "languages": {
    "Python": {
      "language_servers": ["ruff", "basedpyright", "pyright"],
      "format_on_save": "on",
      "formatter": [
        // {
        //   "code_actions": {
        //     "source.organizeImports.ruff": true,
        //     "source.fixAll.ruff": true
        //   }
        // },
        { "language_server": { "name": "ruff" } },
      ],
      "show_edit_predictions": true,
    },
    "JSON": {
      "soft_wrap": "editor_width",
    },
    "LaTeX": {
      "soft_wrap": "editor_width",
    },
  },
  "lsp": {
    "basedpyright": {
      "settings": {
        "python": { "pythonPath": ".venv/bin/python" },
        "basedpyright.analysis": { "diagnosticMode": "workspace" },
      },
    },
    "ltex": {
      "settings": {
        "ltex": {
          "language": "en-US",
        },
      },
    },
    "texlab": {
      "settings": {
        "texlab": {
          "latexindent": { "modifyLineBreaks": true },
          "build": {
            "onSave": false,
            "forwardSearchAfter": false,
          },
          "forwardSearch": {
            "executable": "/Applications/Skim.app/Contents/SharedSupport/displayline",
            "args": ["-r", "%l", "%p", "%f"],
          },
          "diagnostics": {
            "ignoredPatterns": [
              "Overfull \\\\hbox",
              "Overfull \\\\vbox",
              "Package hyperref Warning: Suppressing link with empty target",
              "Underfull \\\\hbox",
              "Float too large for page by",
              "Float specifier changed to ht",
              "Unused label",
            ],
          },
          "chktex": {
            "onOpenAndSave": true,
            "onEdit": true,
            "additionalArgs": [
              "-n30",
              "-n24",
              "-n12",
              "-n1",
              "-n35",
              "-n3",
              "-n8",
              "-n44",
            ],
          },
        },
      },
    },
  },

  // File Associations
  "file_types": {
    "Go": ["tpl"],
  },

  // Extensions
  "auto_install_extensions": {
    "html": true,
    "toml": true,
    "lua": true,
    "swift": true,
    "make": true,
    "svelte": true,
    "scss": true,
    "astro": true,
    "latex": true,
    "ltex": true,
    "fish": true,
    "log": true,
    "dockerfile": true,
    "git-firefly": true,
    "rainbow-csv": true,
    "catppuccin": true,
    "catppuccin-icons": true,
  },
}
