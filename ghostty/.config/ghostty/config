# GHOSTTY CONFIG

term = xterm-256color
confirm-close-surface = false

keybind = shift+enter=text:\x1b\r
# keybind = global:cmd+shift+space=toggle_quick_terminal
keybind = global:cmd+shift+alt+ctrl+space=toggle_quick_terminal


clipboard-read = allow
clipboard-write = allow

theme = One Half Dark
background = #23272e
background-opacity = 0.9
background-blur = 40
cursor-color = #65f859

font-size=13.5

window-inherit-working-directory = true
window-padding-balance = true
window-padding-x = 10,10
window-padding-y = 5,10
window-height = 36
window-width = 120

quick-terminal-position = center
quick-terminal-size = 60%,70%