# SMB Auto-Connect Configuration
# Copdy to .env and customize for your network.

EXPECTED_GATEWAY="XXX.XXX.XXX.XXX"
SERVER_IP="XXX.XXX.XXX.XXX"
SERVER_HOST="Host-Name.local"
SMB_PORT=445
SMB_USER="$USER"
KEYCHAIN_SERVER="$SERVER_HOST"
SMB_SHARE="Path_to_mount"
LOG_FILE="$HOME/Library/Logs/smb-connect.log"
MAX_ATTEMPTS=1000
RETRY_INTERVAL=0.25
